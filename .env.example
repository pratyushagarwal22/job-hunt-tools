# .env.example — environment variables for job-hunt-tools
# Copy to .env and fill in values. Never commit .env.

# Google Sheets
# TEST sheet ID only locally; the real sheet ID lives only in GitHub secrets
SHEET_ID=
# Path to the service account key at repo root, gitignored
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# Serper (job search)
# From serper.dev dashboard
SERPER_API_KEY=

# Anthropic (job scoring + outreach drafts)
# From console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Prospeo (email_finder provider 1)
# From the Prospeo dashboard; free plan, 100 credits/month
PROSPEO_API_KEY=

# Apify (email_finder provider 2, actor vulnv/linkedin-email-finder)
# From Apify → Settings → API & Integrations; free plan, $5/month credit
APIFY_TOKEN=

# Apollo (email_finder, optional, paid plan only)
# The free plan's API returns 403; only needed if apollo is in email_finder/settings.yaml providers
APOLLO_API_KEY=
